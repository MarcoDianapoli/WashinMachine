{
  "expo": {
    "name": "Washing Machine",
    "slug": "autolavado",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "autolavado",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0f",
        "foregroundImage": "./assets/images/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.marcodianapoli.autolavado"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "meta": {
        "description": "Autolavado - Reserva tu lavado fácil y rápido",
        "viewport": "width=device-width, initial-scale=1, viewport-fit=cover",
        "apple-mobile-web-app-capable": "yes",
        "apple-mobile-web-app-status-bar-style": "default"
      },
      "manifest": {
        "name": "Autolavado",
        "short_name": "Autolavado",
        "description": "Reserva tu servicio de autolavado fácil y rápido",
        "start_url": "/",
        "scope": "/",
        "display": "standalone",
        "orientation": "portrait",
        "lang": "es-MX",
        "background_color": "#0d0d0f",
        "theme_color": "#0d0d0f",
        "prefer_related_applications": false,
        "icons": [
          {
            "src": "/assets/images/logo.png",
            "sizes": "192x192",
            "type": "image/png"
          },
          {
            "src": "/assets/images/logo.png",
            "sizes": "512x512",
            "type": "image/png"
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      "./plugins/withForegroundService",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#ef3b42",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-speedometer.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#0d0d0f",
          "dark": {
            "image": "./assets/images/splash-speedometer.png",
            "backgroundColor": "#0d0d0f"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22150c6c-59b3-47f0-b3ab-9fb3e8540c95"
      }
    }
  }
}
